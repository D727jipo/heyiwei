<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 (API 31+) 自带现代化主题: Material You 取色 + DayNight + 系统 SplashScreen -->
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:colorPrimary">@color/md_primary</item>
        <item name="android:colorBackground">@color/md_surface</item>
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Android 12 自带的系统启动画面(开屏) -->
        <item name="android:windowSplashScreenBackground">@color/md_primary_container</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/md_surface</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
