<?xml version="1.0" encoding="utf-8"?>
<!-- 完整结果查看器: 分页浏览全部数字, 可复制/导出 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/full_result_title"
            android:textColor="@color/md_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/frClose"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/ripple_ghost"
            android:minWidth="0dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/full_result_close"
            android:textColor="@color/md_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/frInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/md_on_surface_variant"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:padding="10dp">

        <TextView
            android:id="@+id/frText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/md_on_surface"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:typeface="monospace" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/frFirst"
            style="@style/Key"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/fr_first" />

        <Button
            android:id="@+id/frPrev"
            style="@style/Key"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/fr_prev" />

        <Button
            android:id="@+id/frNext"
            style="@style/Key"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/fr_next" />

        <Button
            android:id="@+id/frLast"
            style="@style/Key"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/fr_last" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/frCopyPage"
            style="@style/OpKey"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/fr_copy_page" />

        <Button
            android:id="@+id/frCopyAll"
            style="@style/OpKey"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/fr_copy_all" />

        <Button
            android:id="@+id/frExport"
            style="@style/EqKey"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/fr_export" />
    </LinearLayout>
</LinearLayout>
